# backend/.env — Spring Boot local 프로필용 파일.
# 이 파일을 복사해 backend/.env 를 만들고 실제 값을 채워 넣으세요. backend/.env 는 gitignore 대상입니다.
# 이 파일(.env.example)에는 실제 시크릿을 절대 넣지 마세요. placeholder만 사용합니다.
# 값 뒤에는 인라인 주석을 달 수 없습니다(파서가 지원하지 않음). 같은 키를 중복 선언하지 마세요.

KAKAO_CLIENT_ID=<카카오-REST-API-키>
KAKAO_CLIENT_SECRET=

# 구글 OAuth 방식이 결정된 뒤(Phase A 이후)에 설정하세요. Phase A에서는 사용하지 않습니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 선택 항목입니다. 모바일 클라이언트는 보통 요청 본문에 redirect_uri를 직접 담아 보냅니다.
KAKAO_REDIRECT_URI=
GOOGLE_REDIRECT_URI=

# 선택 항목입니다. application.yml에 이미 JWT_SECRET의 local 개발용 기본값이 있습니다.
JWT_SECRET=

# 사진 저장소. 기본값(local)은 backend/.local-storage 에 저장하고 /local-storage 로 서빙합니다.
# 로컬에서 R2 를 직접 써 보려면 아래 주석을 풀고 값을 채우세요 (운영 버킷과 분리된 개발용 버킷 권장).
# STORAGE_TYPE=s3
# STORAGE_BUCKET=
# STORAGE_PUBLIC_BASE_URL=
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

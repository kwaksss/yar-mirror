# 운영 서버용 환경변수 예시. 서버에서 /opt/yar-mirror/.env 로 복사해 실제 값을 채운다.
# 실제 .env 는 서버에만 두고 절대 커밋하지 않는다.
# 형식: KEY=value (따옴표·공백·인라인 주석 금지 — compose, Spring, 쉘 스크립트가 같이 읽는다)

# ---- 도메인 / 이미지 ----
API_DOMAIN=api.example.com
APP_IMAGE=ghcr.io/<github-owner>/yar-mirror-backend
# 배포 시 scripts/deploy.sh 가 자동으로 바꾼다.
IMAGE_TAG=latest

# ---- DB (PostGIS 컨테이너) ----
POSTGRES_DB=yarmirror
POSTGRES_USER=yarmirror
POSTGRES_PASSWORD=<openssl rand -base64 32 결과>
DB_POOL_SIZE=10

# ---- 인증 ----
JWT_SECRET=<openssl rand -base64 48 결과>
KAKAO_CLIENT_ID=<카카오-REST-API-키>
KAKAO_CLIENT_SECRET=
# 카카오 개발자 콘솔에 등록한 운영 redirect URI (웹앱 도메인 기준)
KAKAO_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---- CORS: 웹앱(Cloudflare Pages) 도메인. 여러 개면 쉼표로 구분 ----
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com

# ---- 사진 저장소: Cloudflare R2 (STORAGE_TYPE=s3 는 compose 가 지정) ----
STORAGE_BUCKET=yar-mirror-photos
# 버킷에 연결한 커스텀 도메인 (공개 읽기)
STORAGE_PUBLIC_BASE_URL=https://photos.example.com
STORAGE_PRESIGN_TTL=600
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
# photos 버킷 전용 R2 API 토큰 (Object Read & Write)
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ---- DB 백업 (scripts/backup.sh → R2 비공개 버킷) ----
BACKUP_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_R2_BUCKET=yar-mirror-backups
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
